# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Django core ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database ---
# "mysql" (default, primary database) or "sqlite" (handy for quick local test runs only)
DB_ENGINE=mysql
DB_NAME=task_manager
DB_USER=task_manager_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS: the frontend origin(s) allowed to call the API (comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (used by `python manage.py send_task_reminders`) ---
# Console backend prints emails to the terminal. For real SMTP use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Task Manager <no-reply@example.com>

# --- Production hardening (set True when served over HTTPS) ---
SECURE_COOKIES=False
